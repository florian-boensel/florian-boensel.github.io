          </g>
          <!-- Fibonacci tiling strip (long=teal, short=gold) -->
          <g>
            <rect x="-130" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="-106.5" y="34" width="14.4" height="12" fill="#f0b94a"/><rect x="-92.1" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="-68.6" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="-45.1" y="34" width="14.4" height="12" fill="#f0b94a"/><rect x="-30.7" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="-7.2" y="34" width="14.4" height="12" fill="#f0b94a"/><rect x="7.2" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="30.7" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="54.2" y="34" width="14.4" height="12" fill="#f0b94a"/><rect x="68.6" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="92.1" y="34" width="23.5" height="12" fill="#2bb3a3"/><rect x="115.6" y="34" width="14.4" height="12" fill="#f0b94a"/>
