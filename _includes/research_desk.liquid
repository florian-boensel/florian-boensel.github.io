    <!-- 6) Metal spheres in an oscillating magnetic field -->
    <a class="desk-item" href="{{ '/projects/metal-spheres/' | relative_url }}" xlink:href="{{ '/projects/metal-spheres/' | relative_url }}">
      <title>Multiple Metal Spheres in Oscillating Magnetic Fields (IEEE Transactions on Magnetics, 2022)</title>
      <g transform="translate(652,778)">
        <ellipse class="desk-shadow" cx="0" cy="90" rx="128" ry="20"/>
        <g class="desk-art">
          <!-- magnetic field loops -->
          <g fill="none" stroke="#f0a93a" stroke-width="2.6">
            <ellipse cx="0" cy="6" rx="120" ry="56" opacity="0.85"/><ellipse cx="0" cy="6" rx="92" ry="40" opacity="0.7"/><ellipse cx="0" cy="6" rx="64" ry="26" opacity="0.55"/>
          </g>
          <path d="M118 -8 l10 6 l-4 11" fill="none" stroke="#f0a93a" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M-118 20 l-10 -6 l4 -11" fill="none" stroke="#f0a93a" stroke-width="2.6" stroke-linecap="round"/>
