{%- comment -%}
  "My research desk" — illustrated, interactive. Each object is a research
  project; hover shows a label, click opens its sub-page. Inline SVG + CSS.
{%- endcomment -%}
<div class="desk-wrap">
  <p class="desk-hint">My research, on one desk — hover an object to see what it is, then click to open the project.</p>
  <svg class="desk-svg" viewBox="0 0 1280 900" xmlns="http://www.w3.org/2000/svg"
       xmlns:xlink="http://www.w3.org/1999/xlink" role="group"
       aria-label="Interactive desk of research projects">
    <defs>
      <linearGradient id="dk-wood" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#d9af80"/><stop offset="100%" stop-color="#c6965d"/>
      </linearGradient>
      <radialGradient id="dk-metal" cx="36%" cy="30%" r="78%">
        <stop offset="0%" stop-color="#f3f7fb"/><stop offset="45%" stop-color="#9fb1c4"/><stop offset="100%" stop-color="#3f4e62"/>
      </radialGradient>
      <radialGradient id="dk-metal2" cx="36%" cy="30%" r="78%">
        <stop offset="0%" stop-color="#fbfcfd"/><stop offset="50%" stop-color="#aeb9c5"/><stop offset="100%" stop-color="#525d6c"/>
      </radialGradient>
      <radialGradient id="dk-gold" cx="38%" cy="32%" r="75%">
        <stop offset="0%" stop-color="#ffe9a8"/><stop offset="55%" stop-color="#f0b94a"/><stop offset="100%" stop-color="#bd8226"/>
      </radialGradient>
      <radialGradient id="dk-bound" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffe27a" stop-opacity="0.95"/><stop offset="100%" stop-color="#ffe27a" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="dk-lamp" cx="50%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#fff3c4" stop-opacity="0.95"/><stop offset="100%" stop-color="#fff3c4" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="dk-cone" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#ff5d6c" stop-opacity="0.85"/><stop offset="100%" stop-color="#ff5d6c" stop-opacity="0.12"/>
      </linearGradient>
      <radialGradient id="dk-emit" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#7fd0ff"/><stop offset="100%" stop-color="#3b86d6"/>
      </radialGradient>
      <filter id="dk-glow" x="-70%" y="-70%" width="240%" height="240%">
        <feGaussianBlur stdDeviation="2.4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <!-- background + desk -->
    <rect x="0" y="0" width="1280" height="900" fill="#f4ecdf"/>
    <rect x="28" y="54" width="1224" height="818" rx="28" fill="url(#dk-wood)"/>
    <rect x="28" y="54" width="1224" height="818" rx="28" fill="none" stroke="#a9764a" stroke-opacity="0.35" stroke-width="2"/>
    <g stroke="#b9824f" stroke-opacity="0.26" stroke-width="2" fill="none" stroke-linecap="round">
      <path d="M60 210 q320 -14 620 0 t560 6"/><path d="M60 470 q300 14 600 2 t600 -8"/><path d="M60 720 q320 -12 620 2 t560 4"/>
    </g>

    <!-- ===================== AMBIANCE ===================== -->
    <g><!-- lamp, top-left -->
      <ellipse cx="150" cy="250" rx="40" ry="13" fill="#3b4654"/>
      <rect x="145" y="120" width="10" height="132" rx="5" fill="#566373"/>
      <rect x="150" y="104" width="104" height="10" rx="5" fill="#566373" transform="rotate(30 150 109)"/>
      <path d="M226 120 l50 30 l-26 28 l-44 -34 z" fill="#3b4654"/>
      <ellipse cx="242" cy="170" rx="34" ry="16" fill="url(#dk-lamp)"/>
      <circle cx="242" cy="158" r="8" fill="#ffe9a8"/>
    </g>
    <g><!-- plant, top-right -->
      <ellipse cx="1168" cy="250" rx="40" ry="12" fill="#3a2a17" opacity="0.14"/>
      <path d="M1168 196 q-38 -6 -44 -54 q34 8 44 54 z" fill="#5aa264"/>
      <path d="M1168 196 q40 -8 48 -58 q-38 10 -48 58 z" fill="#4c9457"/>
      <path d="M1168 200 q-8 -44 4 -78 q16 34 -4 78 z" fill="#69b673"/>
      <path d="M1142 206 h52 l-8 46 h-36 z" fill="#c9714c"/>
      <rect x="1136" y="198" width="64" height="14" rx="4" fill="#d77f57"/>
    </g>
    <g><!-- coffee mug, mid-right -->
      <ellipse cx="1180" cy="556" rx="36" ry="11" fill="#3a2a17" opacity="0.14"/>
      <path d="M1168 500 q14 -10 28 0 a6 6 0 0 1 10 6 q-8 8 -16 3 z" fill="none" stroke="#e7e2da" stroke-width="8"/>
      <rect x="1150" y="506" width="54" height="50" rx="9" fill="#eef0f2"/>
      <ellipse cx="1177" cy="508" rx="27" ry="7" fill="#7c5a3e"/>
      <path d="M1170 488 q-5 -10 3 -18 M1184 488 q-5 -10 3 -18" fill="none" stroke="#cdbfae" stroke-width="3.5" stroke-linecap="round"/>
    </g>
    <g transform="rotate(-22 520 856)"><!-- pen -->
      <rect x="450" y="849" width="120" height="13" rx="6" fill="#3f7fd0"/>
      <path d="M570 849 l20 6.5 l-20 6.5 z" fill="#f4d06b"/>
      <rect x="446" y="849" width="12" height="13" rx="3" fill="#2b5fa6"/>
    </g>

    <!-- ===================== PROJECT OBJECTS ===================== -->

    <!-- 1) EPR / SPDC optics bench -->
    <a class="desk-item" href="{{ '/projects/epr-states/' | relative_url }}" xlink:href="{{ '/projects/epr-states/' | relative_url }}">
      <title>Idealized EPR States from Parametric Down-Conversion (Phys. Rev. A, 2020)</title>
      <g transform="translate(250,430)">
        <ellipse class="desk-shadow" cx="0" cy="96" rx="150" ry="22"/>
        <g class="desk-art">
          <!-- breadboard (isometric slab) -->
          <polygon points="-135,58 120,58 152,84 -103,84" fill="#26344a"/>
          <polygon points="-135,58 -103,84 -103,96 -135,70" fill="#1a2636"/>
          <polygon points="-103,84 152,84 152,96 -103,96" fill="#1d2a3d"/>
          <g fill="#39496180"><circle cx="-96" cy="72" r="2.4"/><circle cx="-64" cy="72" r="2.4"/><circle cx="-32" cy="72" r="2.4"/><circle cx="0" cy="72" r="2.4"/><circle cx="32" cy="72" r="2.4"/><circle cx="64" cy="72" r="2.4"/><circle cx="96" cy="72" r="2.4"/><circle cx="-80" cy="64" r="2.4"/><circle cx="-16" cy="64" r="2.4"/><circle cx="48" cy="64" r="2.4"/><circle cx="112" cy="64" r="2.4"/></g>
          <!-- posts -->
          <g fill="#7a869a"><rect x="-118" y="20" width="9" height="46" rx="3"/><rect x="-40" y="26" width="8" height="40" rx="3"/><rect x="6" y="22" width="8" height="44" rx="3"/></g>
          <!-- pump laser -->
          <rect x="-150" y="-2" width="54" height="28" rx="6" fill="#39434f"/>
          <rect x="-150" y="-2" width="54" height="9" rx="4" fill="#4d5866"/>
          <circle cx="-98" cy="12" r="5" fill="#9b7cff"/>
          <!-- pump beam (violet) -->
          <rect x="-93" y="9" width="78" height="6" rx="3" fill="#8a63ff" filter="url(#dk-glow)" opacity="0.9"/>
          <!-- lens -->
          <ellipse cx="-36" cy="12" rx="7" ry="22" fill="#bfe9ff" fill-opacity="0.65" stroke="#5bb6e0" stroke-width="2"/>
          <!-- nonlinear crystal -->
          <rect x="2" y="-8" width="18" height="40" rx="3" fill="#ffd27f" fill-opacity="0.9" stroke="#d79a36" stroke-width="2"/>
          <!-- SPDC cones (signal/idler) -->
          <polygon points="20,12 150,-30 150,-6" fill="url(#dk-cone)"/>
          <polygon points="20,12 150,54 150,30" fill="url(#dk-cone)"/>
          <line x1="20" y1="12" x2="150" y2="-30" stroke="#ff5d6c" stroke-width="2"/>
          <line x1="20" y1="12" x2="150" y2="54" stroke="#ff5d6c" stroke-width="2"/>
          <!-- entangled photons -->
          <circle cx="92" cy="-3" r="5" fill="#ffe680" filter="url(#dk-glow)"/>
          <circle cx="92" cy="27" r="5" fill="#ffe680" filter="url(#dk-glow)"/>
          <path d="M92 -3 Q120 12 92 27" fill="none" stroke="#ffe680" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8"/>
          <!-- detectors -->
          <g fill="#4a5670"><rect x="150" y="-44" width="34" height="26" rx="5"/><rect x="150" y="40" width="34" height="26" rx="5"/></g>
          <circle cx="150" cy="-31" r="6" fill="#222b3a"/><circle cx="150" cy="53" r="6" fill="#222b3a"/>
          <!-- coincidence box -->
          <rect x="150" y="-2" width="30" height="30" rx="4" fill="#5a6478"/>
          <text x="165" y="18" font-size="16" fill="#ffe680" text-anchor="middle" font-family="monospace">&amp;</text>
        </g>
        <g class="desk-tip" transform="translate(0,-90)">
          <rect class="tip-box" x="-108" y="-19" width="216" height="32" rx="9"/><text class="tip-text" x="0" y="2">EPR Entanglement · 2020</text>
        </g>
      </g>
    </a>

    <!-- 2) Fractal photonic lattice (Sierpinski gasket + bound-state emitter) -->
    <a class="desk-item" href="{{ '/projects/fractal-photonic-lattices/' | relative_url }}" xlink:href="{{ '/projects/fractal-photonic-lattices/' | relative_url }}">
      <title>Atom-Photon Bound States in Fractal Photonic Lattices (arXiv, 2026)</title>
      <g transform="translate(548,438)">
        <ellipse class="desk-shadow" cx="0" cy="92" rx="118" ry="20"/>
        <g class="desk-art">
          <!-- bound-state halo behind emitter -->
          <circle cx="0" cy="-120" r="60" fill="url(#dk-bound)"/>
          <!-- Sierpinski gasket (level 3) -->
          <g fill="#2bb3a3" stroke="#1d8f81" stroke-width="0.8">
            <polygon points="0.0,-120.0 -13.8,-96.2 13.8,-96.2"/><polygon points="-13.8,-96.2 -27.5,-72.5 0.0,-72.5"/><polygon points="13.8,-96.2 0.0,-72.5 27.5,-72.5"/><polygon points="-27.5,-72.5 -41.2,-48.8 -13.8,-48.8"/><polygon points="-41.2,-48.8 -55.0,-25.0 -27.5,-25.0"/><polygon points="-13.8,-48.8 -27.5,-25.0 0.0,-25.0"/><polygon points="27.5,-72.5 13.8,-48.8 41.2,-48.8"/><polygon points="13.8,-48.8 0.0,-25.0 27.5,-25.0"/><polygon points="41.2,-48.8 27.5,-25.0 55.0,-25.0"/><polygon points="-55.0,-25.0 -68.8,-1.2 -41.2,-1.2"/><polygon points="-68.8,-1.2 -82.5,22.5 -55.0,22.5"/><polygon points="-41.2,-1.2 -55.0,22.5 -27.5,22.5"/><polygon points="-82.5,22.5 -96.2,46.2 -68.8,46.2"/><polygon points="-96.2,46.2 -110.0,70.0 -82.5,70.0"/><polygon points="-68.8,46.2 -82.5,70.0 -55.0,70.0"/><polygon points="-27.5,22.5 -41.2,46.2 -13.8,46.2"/><polygon points="-41.2,46.2 -55.0,70.0 -27.5,70.0"/><polygon points="-13.8,46.2 -27.5,70.0 0.0,70.0"/><polygon points="55.0,-25.0 41.2,-1.2 68.8,-1.2"/><polygon points="41.2,-1.2 27.5,22.5 55.0,22.5"/><polygon points="68.8,-1.2 55.0,22.5 82.5,22.5"/><polygon points="27.5,22.5 13.8,46.2 41.2,46.2"/><polygon points="13.8,46.2 0.0,70.0 27.5,70.0"/><polygon points="41.2,46.2 27.5,70.0 55.0,70.0"/><polygon points="82.5,22.5 68.8,46.2 96.2,46.2"/><polygon points="68.8,46.2 55.0,70.0 82.5,70.0"/><polygon points="96.2,46.2 82.5,70.0 110.0,70.0"/>
          </g>
          <!-- emitter (atom) at apex with bound state -->
          <circle cx="0" cy="-120" r="9" fill="#ffd34d" filter="url(#dk-glow)"/>
          <circle cx="0" cy="-120" r="4" fill="#fff6d8"/>
          <!-- decaying bound-state amplitude along the lattice -->
          <g fill="#ffd34d"><circle cx="-13.8" cy="-96.2" r="4" opacity="0.7"/><circle cx="13.8" cy="-96.2" r="4" opacity="0.7"/><circle cx="-27.5" cy="-72.5" r="3" opacity="0.45"/><circle cx="27.5" cy="-72.5" r="3" opacity="0.45"/><circle cx="0" cy="-72.5" r="3" opacity="0.5"/></g>
        </g>
        <g class="desk-tip" transform="translate(0,-188)">
          <rect class="tip-box" x="-96" y="-19" width="192" height="32" rx="9"/><text class="tip-text" x="0" y="2">Fractal Lattices · 2026</text>
        </g>
      </g>
    </a>

    <!-- 3) Curved plasmonics (metallic spheroid + emitter ring + SPP waves) -->
