          </g>
        </g>
        <g class="desk-tip" transform="translate(0,-118)">
          <rect class="tip-box" x="-108" y="-19" width="216" height="32" rx="9"/><text class="tip-text" x="0" y="2">Curved Plasmonics · 2026</text>
        </g>
      </g>
