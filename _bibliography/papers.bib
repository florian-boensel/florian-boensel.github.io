@article{boensel2026fractal,
  abbr        = {arXiv},
  bibtex_show = {true},
  title       = {Atom-Photon Bound States in Fractal Photonic Lattices: Localization Length and Anomalous Diffusion},
  author      = {Bönsel, Florian and Kunst, Flore K. and Roccati, Federico},
  journal     = {arXiv preprint arXiv:2605.23625},
  year        = {2026},
  arxiv       = {2605.23625},
  abstract    = {We study atom-photon bound states seeded by two-level emitters coupled to self-similar (fractal) photonic lattices. We show that the far-field localization length obeys a scaling law governed by anomalous diffusion, without relying on translational invariance or a band-edge effective-mass approximation. Exact diagonalization on Sierpiński gaskets, pyramids, Vicsek graphs, and Sierpiński carpets confirms the predictions; in the near field, the bound-state amplitude exhibits an additional algebraic variation.},
  selected    = {true}
}

@article{boensel2026helmholtz,
  abbr        = {arXiv},
  bibtex_show = {true},
  title       = {A Helmholtz Equation for Surface Plasmon Polaritons on Curved Interfaces: Controlling Cooperativity with Geometric Potentials},
  author      = {Bönsel, Florian and Kunst, Flore K.},
  journal     = {arXiv preprint arXiv:2603.27702},
  year        = {2026},
  arxiv       = {2603.27702},
  abstract    = {We derive a covariant, effective two-dimensional wave equation for the transverse-magnetic surface plasmon polariton mode on weakly curved smooth metal-dielectric interfaces. A perturbative expansion of Maxwell's equations with curvature-adapted boundary conditions yields a Helmholtz equation with two geometric potential terms that are linear in the extrinsic curvature and distinguish convex from concave interfaces. As an application, we demonstrate sign-dependent cooperative frequency shifts and a curvature-driven redistribution of superradiant and subradiant decay rates for a ring of quantum emitters on a curved metallic spheroid.},
  selected    = {true}
}

@article{boensel2026fibonacci,
  abbr        = {Quantum},
  bibtex_show = {true},
  title       = {Fibonacci Waveguide Quantum Electrodynamics},
  author      = {Bönsel, Florian and Kunst, Flore K. and Roccati, Federico},
  journal     = {Quantum},
  volume      = {10},
  pages       = {2081},
  year        = {2026},
  doi         = {10.22331/q-2026-04-23-2081},
  arxiv       = {2507.06308},
  abstract    = {We investigate waveguide quantum electrodynamics in a one-dimensional photonic array whose hopping strengths are structured aperiodically according to the deterministic Fibonacci-Lucas substitution rule. These "Fibonacci waveguides" lack translational invariance and feature a singular continuous spectrum and critical eigenstates, representing a deterministic intermediate between order and disorder. We show how to achieve decoherence-free, coherent interactions in this setting, establishing aperiodic waveguides as a versatile and experimentally feasible platform for engineering quantum emitter interactions.},
  selected    = {true}
}

