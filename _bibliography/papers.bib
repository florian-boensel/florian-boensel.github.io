@article{okoth2020epr,
  abbr        = {Phys. Rev. A},
  bibtex_show = {true},
  title       = {Idealized Einstein-Podolsky-Rosen States from Non–Phase-Matched Parametric Down-Conversion},
  author      = {Okoth, C. and Kovlakov, E. and Bönsel, Florian and Cavanna, A. and Straupe, S. and Kulik, S. P. and Chekhova, M. V.},
  journal     = {Physical Review A},
  year        = {2020},
  arxiv       = {1907.09888},
  abstract    = {We show that reducing a highly nonlinear material to micrometer dimensions relaxes longitudinal phase-matching constraints. Using a micron-sized lithium niobate layer, we achieve record levels of transverse-wavevector entanglement, with an estimated 1200+ entangled angular modes, confirmed through correlation measurements and stimulated emission tomography. Such highly entangled photonic states can enhance quantum information capacity and improve resolution in quantum imaging.},
  selected    = {true}
}
