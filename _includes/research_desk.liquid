          <circle cx="-68.6" cy="-40" r="13" fill="url(#dk-emit)" filter="url(#dk-glow)"/>
          <circle cx="54.2" cy="-40" r="13" fill="url(#dk-emit)" filter="url(#dk-glow)"/>
          <circle cx="-72" cy="-44" r="4" fill="#dff1ff"/><circle cx="50.8" cy="-44" r="4" fill="#dff1ff"/>
