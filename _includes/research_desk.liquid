    <!-- 4) Fibonacci waveguide QED (aperiodic chain + tiling + emitters) -->
    <a class="desk-item" href="{{ '/projects/fibonacci-waveguide-qed/' | relative_url }}" xlink:href="{{ '/projects/fibonacci-waveguide-qed/' | relative_url }}">
      <title>Fibonacci Waveguide Quantum Electrodynamics (Quantum, 2026)</title>
