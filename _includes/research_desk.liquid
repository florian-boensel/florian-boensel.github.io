            <circle cx="48" cy="-44" r="6" fill="#ff7ea8" opacity="0.55"/>
            <circle cx="66" cy="0" r="6" fill="#ff7ea8" filter="url(#dk-glow)"/>
            <circle cx="48" cy="44" r="6" fill="#ff7ea8" opacity="0.5"/>
